{
  "name": "line-chrome-mcp",
  "version": "0.1.0",
  "description": "Local LINE Chrome gateway with REST, SSE events, MCP Streamable HTTP and MCP stdio transports.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "line-gateway": "./dist/src/index.js",
    "line-mcp": "./dist/src/mcp/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "mcp:stdio": "node dist/src/mcp/stdio.js",
    "mcp:stdio:dev": "tsx src/mcp/stdio.ts",
    "test": "node --test dist/test/*.test.js",
    "check": "npm run build && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "playwright-core": "1.63.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
